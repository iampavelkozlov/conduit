# Copy this file to .env and replace every change-me value before deployment.
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32

AUTH_JWT_SECRET=change-me-use-openssl-rand-hex-48
AUTH_PASSWORD_PEPPER=change-me-use-openssl-rand-hex-32
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

HTTP_ALLOWED_ORIGINS=https://192.168.0.109
LOG_LEVEL=info
LOG_FORMAT=json

PUBLIC_HOST=192.168.0.109
CONDUIT_BIND_ADDRESS=0.0.0.0
CONDUIT_API_PULL_POLICY=build
CONDUIT_FRONTEND_PULL_POLICY=build
